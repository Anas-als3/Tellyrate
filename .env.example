# ---------------------------------------------------------------------------
# Hospirate — environment variables
# Copy to `.env` for local development. Set these in your host's dashboard
# (Vercel / Railway / Docker) for production.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local (docker compose):
#   postgresql://hospirate:hospirate@localhost:5433/hospirate?schema=public
# Serverless (Neon / Supabase) — use the POOLED connection string:
#   postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=

# Direct (non-pooled) connection, used only by `prisma migrate`.
# On Neon/Supabase this is the "direct"/"session" connection string.
# Leave unset locally — it falls back to DATABASE_URL.
DIRECT_URL=

# 32+ random bytes, base64. Used to derive the daily rotating salt that
# pseudonymises IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IP_HASH_SECRET=

# Public origin of the deployment, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which deployment this is: production | staging | development.
# On Vercel this is derived from VERCEL_ENV automatically and you can leave it
# unset — every preview deployment counts as staging. Set it explicitly only
# when self-hosting a staging box, where nothing else can tell the difference.
# Anything other than "production" refuses all crawlers and shows a banner.
APP_ENV=development
